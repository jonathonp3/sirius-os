[Unit]
Description=Sirius OS: provision on first boot
After=local-fs.target
# Only run once per install
ConditionPathExists=!/etc/sirius-os/sirius-os-provisioned

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/bash /usr/libexec/sirius-os-provision.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
