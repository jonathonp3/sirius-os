[Unit]
Description=Sirius-OS First Boot Optimization
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/etc/sirius-os/firstboot-done

[Service]
Type=oneshot
ExecStart=/usr/libexec/sirius-os-optimization.sh
RemainAfterExit=yes
Restart=no
TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
